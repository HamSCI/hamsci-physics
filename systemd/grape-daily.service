[Unit]
Description=GRAPE Daily Processing
Documentation=https://github.com/HamSCI/hamsci-physics
After=network.target

[Service]
Type=oneshot
User=timestd
Group=timestd
WorkingDirectory=/var/lib/timestd
# Operator identity (callsign, grid) from sigmond — CLIENT-CONTRACT §14.2
EnvironmentFile=-/etc/sigmond/coordination.env

Environment=PATH=/opt/git/sigmond/hamsci-physics/venv/bin:/usr/bin:/bin

# Full orchestrated pipeline: decimate → package → upload
# Gate: at least one channel decimated and one OBS dataset packaged.  Spectrograms only when [grape] spectrograms = true; never a gate.
ExecStart=/opt/git/sigmond/hamsci-physics/venv/bin/python3 -m hamsci_physics.cli grape daily

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grape-daily

# Run at lowest priority to avoid interfering with real-time services.
# CPUWeight=idle puts the cgroup in cpu.idle: it runs only on CPU the
# recorders leave unused (AB4EJ 2026-11-20: at normal priority it carried
# 21 % of the station's CPU pressure while FT8 decodes queued behind it).
Nice=19
CPUWeight=idle
IOSchedulingClass=idle

# Resource limits (optional)
CPUQuota=50%
MemoryMax=6G

[Install]
WantedBy=multi-user.target
